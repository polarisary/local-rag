# Milvus
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=enterprise_rag_demo

# LLM（支持任意 OpenAI 兼容接口：DeepSeek / 硅基流动 / 智谱 / 通义千问 等）
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct

# Embedding
EMBEDDING_MODEL=BAAI/bge-m3

# App
APP_PORT=8000
INGEST_FOLDER=/app/test_data

# HuggingFace
HF_ENDPOINT=https://huggingface.co

# RAG 检索配置
CHUNK_SIZE=512
CHUNK_OVERLAP=80
RETRIEVE_TOP_K=4
SIMILARITY_THRESHOLD=0.35
LLM_TIMEOUT=180
